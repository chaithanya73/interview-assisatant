{
  "name": "audio-device-service",
  "version": "1.0.0",
  "description": "Windows Audio Device Management Service",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dev": "electron . --dev",
    "build": "electron-builder --win"
  },
  "keywords": ["audio", "service", "system"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.system.audiodeviceservice",
    "productName": "Audio Device Service",
    "win": {
      "target": "portable",
      "icon": null
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
